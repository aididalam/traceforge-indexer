{
  "name": "@traceforge/indexer",
  "version": "0.1.0",
  "description": "TraceForge blockchain event indexer and MySQL read model",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsx src/check.ts",
    "migrate": "tsx src/migrate.ts",
    "backfill": "tsx src/backfill.ts",
    "status": "tsx src/status.ts",
    "project": "tsx src/project.ts",
    "project:rebuild": "tsx src/project.ts --rebuild",
    "read-model:status": "tsx src/read-model-status.ts",
    "history": "tsx src/entity-history.ts",
    "documents:import": "tsx src/import-documents.ts",
    "documents:status": "tsx src/document-status.ts",
    "semantics:import": "tsx src/import-semantics.ts config/semantics/9009.json",
    "semantics:status": "tsx src/semantic-status.ts",
    "semantics:discover": "tsx src/discover-semantics.ts",
    "build": "tsc",
    "verify:production-build": "npm run build && node --check dist/check.js && node --check dist/backfill.js && node --check dist/project.js",
    "check:prod": "node dist/check.js",
    "backfill:prod": "node dist/backfill.js",
    "project:prod": "node dist/project.js",
    "sync:prod": "npm run check:prod && npm run backfill:prod && npm run project:prod",
    "verify:deployment-readiness": "npm run typecheck && npm run verify:production-build && npm run check:prod && npm run backfill:prod && npm run project:prod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.5",
    "mysql2": "^3.24.5",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
